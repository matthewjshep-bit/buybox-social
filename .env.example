# Postgres connection. Local: the PGlite server from `pnpm db:local`.
# Production: the Supabase "Transaction pooler" connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# PGlite takes one connection at a time. Use 5 on Supabase.
DATABASE_POOL_MAX=1

# Public URL of the app, used in emails and link previews.
APP_URL=http://localhost:3000

# Supabase Auth (email sign-in links). Leave blank locally.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Passwordless local sign-in. Ignored whenever Supabase Auth is configured.
# Never set this on a deployed site.
ALLOW_DEV_LOGIN=true

# Resend (agent email alerts). Blank: emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=BuyBox Social <alerts@example.com>

# Anthropic (the short description of someone's taste on their page).
# Blank: the taste description is written from a template.
ANTHROPIC_API_KEY=
